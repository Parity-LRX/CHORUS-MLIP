# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
build/
dist/
.pytest_cache/
.ipynb_checkpoints/

# Compiled extensions / native build outputs
*.so
*.o
*.a
*.dylib

# Precomputed ICTD Clebsch-Gordan / U-tensor cache (~47M of .pt blobs).
# Regenerated on demand by chorus.models.ictd_disk_cache.load_or_compute, so it is
# a build artifact, not source.
chorus/models/_ictd_cache/

# Model / run artifacts
benchmark_results/
benchmarks/paper/results/**/checkpoints/
benchmarks/paper/**/*.pdf
benchmarks/paper/**/*.png
benchmarks/paper/**/*.npz
*.pt2
*.pt
*.pth
!chorus/models/_ictd_basis/
!chorus/models/_ictd_basis/v1/
!chorus/models/_ictd_basis/v1/*.pt
checkpoint/
*.log

# Manuscripts are maintained outside the software repository.
/paper/
/CHORUS_manuscript*/

# Local research notes and scratch work
*_research/
tmp/

# OS
.DS_Store

# Per-batch training telemetry CSVs (116M across campaigns; regenerable,
# and the audited artifacts are the per-run metrics.json / selection.json).
metrics_batch_train.csv
metrics_batch_val.csv

